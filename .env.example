# MongoDB Atlas Backup (Required for session restore across dynos)
MONGODB_URI=mongodb+srv://...

# Multi-Tenant 40-Session Worker Tuning (All other defaults exist in code)
WORKER_ID=mini-1
MAX_SESSIONS=40
RAM_SOFT_LIMIT_MB=465
CLUSTER_SECRET=replace_with_your_cluster_secret
MASTER_OWNER_NUMBERS=923438673242

# Web SaaS Portal (PORTAL_URL defaults to https://sigmamini.vercel.app; SUPABASE keys NOT needed on worker dynos)
PORTAL_URL=https://sigmamini.vercel.app
MINI_CLUSTER_NODES=https://sigmaminibot-8fdafb0f00ef.herokuapp.com
